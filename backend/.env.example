# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/clinic_db

# ============================================================================
# JWT AUTHENTICATION
# ============================================================================

# JWT Access Token Secret (minimum 32 characters)
JWT_SECRET=clinic-app-super-secret-jwt-key-change-this-in-production-12345

# JWT Access Token Expiration
JWT_EXPIRATION=7d

# JWT Refresh Token Secret (different from JWT_SECRET!)
REFRESH_TOKEN_SECRET=clinic-app-refresh-token-secret-key-change-this-too-67890

# JWT Refresh Token Expiration
REFRESH_TOKEN_EXPIRATION=30d

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================

PORT=8080
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:*,http://10.0.2.2:*

# ============================================================================
# ZOHO MAIL SMTP (info@whabbiton.com)
# ============================================================================

SMTP_HOST=smtppro.zoho.eu
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=info@whabbiton.com
SMTP_PASSWORD=YOUR_ZOHO_APP_PASSWORD_HERE
EMAIL_FROM="Ordana Clinic <info@whabbiton.com>"
FRONTEND_URL=http://localhost:8080
